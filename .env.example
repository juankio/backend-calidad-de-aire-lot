# Air Guardian IoT - Configuración de Backend (NestJS + Bun)
PORT=3002
NODE_ENV=production

# Persistencia de Datos SQLite (Data Lakehouse Medallion)
# Local: ./air_guardian_datalake.sqlite
# Docker / Cloud (Railway, Render, Fly.io): /app/data/air_guardian_datalake.sqlite
DATABASE_PATH=/app/data/air_guardian_datalake.sqlite

# Seguridad y CORS
# Orígenes permitidos adicionales separados por comas
CORS_ORIGIN=https://frontend-calidad-de-aire-lot.vercel.app
